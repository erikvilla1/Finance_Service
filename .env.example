# ---------------------------------------------------------------
# Financial Lending Specialists — environment variables
#
# Copy to .env.local and fill in. NEVER commit .env.local.
# Platform spec §28: no API keys in frontend code, secrets in env only.
# ---------------------------------------------------------------

# ---------------------------------------------------------------
# Supabase keys
#
# Supabase renamed these. In the dashboard (Project Settings -> API) you'll see
# a PUBLISHABLE key and a SECRET key, which replaced the older anon and
# service_role keys respectively.
#
#   Publishable (sb_publishable_...)  -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#   Secret      (sb_secret_...)       -> SUPABASE_SERVICE_ROLE_KEY
#
# The env var names below keep the old wording because that's what the code
# reads; only the key format changed.
# ---------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://crgvrzcifidcpfhazhxu.supabase.co

# Publishable key. Safe in the browser by design — RLS is the real boundary.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_oLemQmh7on_v8jxtluzudw_S4W90JB4

# Secret key. SERVER ONLY — bypasses Row Level Security entirely.
# Never commit a real value here, and never import it into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------
# Not yet integrated — placeholders for later phases
# ---------------------------------------------------------------
# E-signature (Phase 2)
# DOCUSIGN_INTEGRATION_KEY=
# DOCUSIGN_ACCOUNT_ID=

# Email notifications (MVP item 18)
# RESEND_API_KEY=
# NOTIFICATION_TO_EMAIL=

# Analytics (spec §30 — never send financial data to analytics)
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
