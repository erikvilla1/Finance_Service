NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNyZ3ZyemNpZmlkY3BmaGF6aHh1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU4MDQ2MjYsImV4cCI6MjEwMTM4MDYyNn0.ZYg7gsKVloWDysdm08JgSHOqkPUoOgsc9V75qGlajsY

# Supabase — SERVER ONLY. Bypasses Row Level Security.
# Never import this into a client component or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

