# ---------------------------------------------------------------
# Financial Lending Specialists — environment variables
#
# Copy to .env.local and fill in. NEVER commit .env.local.
# Platform spec §28: no API keys in frontend code, secrets in env only.
# ---------------------------------------------------------------

# ---------------------------------------------------------------
# Supabase keys
#
# Supabase renamed these. In the dashboard (Project Settings -> API) you'll see
# a PUBLISHABLE key and a SECRET key, which replaced the older anon and
# service_role keys respectively.
#
#   Publishable (sb_publishable_...)  -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#   Secret      (sb_secret_...)       -> SUPABASE_SERVICE_ROLE_KEY
#
# The env var names below keep the old wording because that's what the code
# reads; only the key format changed.
# ---------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://crgvrzcifidcpfhazhxu.supabase.co

# Publishable key. Safe in the browser by design — RLS is the real boundary.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_oLemQmh7on_v8jxtluzudw_S4W90JB4

# Secret key. SERVER ONLY — bypasses Row Level Security entirely.
# Never commit a real value here, and never import it into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Site. Everything that builds an absolute URL — password-reset links,
# email CTAs, auth redirects — reads this. In production (Vercel env vars):
#   NEXT_PUBLIC_SITE_URL=https://www.flscapitaladvisors.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------
# Not yet integrated — placeholders for later phases
# ---------------------------------------------------------------
# E-signature (Phase 2)
# DOCUSIGN_INTEGRATION_KEY=
# DOCUSIGN_ACCOUNT_ID=

# ---------------------------------------------------------------
# Email notifications (MVP item 18)
#
# Nothing here is required. Without RESEND_API_KEY the app behaves exactly as
# it does with one, minus the sending — a missing key is logged and ignored,
# never thrown, because an unreachable mail server must not fail a document
# upload or a signature.
# ---------------------------------------------------------------

# RESEND_API_KEY=re_...

# The sender. Until a domain is verified in Resend, leave this unset: the
# default is Resend's onboarding address, which only delivers to the account
# owner. Once mail.flscapitaladvisors.com is verified in Resend:
#   EMAIL_FROM="Financial Lending Specialists <notifications@mail.flscapitaladvisors.com>"
# EMAIL_FROM=

# SAFETY CATCH FOR DEVELOPMENT. While set, every message goes to this address
# regardless of who it was addressed to, and the intended recipient is put in
# the subject line. Set it while testing; remove it before real applicants.
# EMAIL_REDIRECT_TO=you@example.com

# Where staff alerts go — a document arriving, an application signed. One
# address rather than the assigned specialist, because an unassigned file is
# exactly the one that goes cold.
# STAFF_NOTIFICATION_EMAIL=

# Analytics (spec §30 — never send financial data to analytics)
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
